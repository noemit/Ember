{
  "name": "ember",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A tiny, fun desktop client for OpenChamber",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "bun run typecheck && vite build && tsc -p tsconfig.electron.json",
    "dev": "bun run build && electron .",
    "dev:web": "vite --port 5179",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.34.0",
    "motion": "13.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.9.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "42.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.3",
    "vite": "8.2.2"
  }
}
